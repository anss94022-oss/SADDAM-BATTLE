; SADDAM BATTLE — Godot 4.3 project file
; Ultra 3D military action game for Android (offline)

config_version=5

[application]

config/name="SADDAM BATTLE"
config/description="لعبة أكشن عسكرية ثلاثية الأبعاد — حرب، قنص، مهام، وتقدّم."
config/version="1.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.0196078, 0.027451, 0.0431373, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

SaveSystem="*res://scripts/save/save_system.gd"
GameSettings="*res://scripts/settings/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.0196078, 0.027451, 0.0431373, 1)
