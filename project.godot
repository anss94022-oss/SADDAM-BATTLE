; SADDAM BATTLE — Godot 4.3 project (Android, offline, local multiplayer)
config_version=5

[application]

config/name="SADDAM BATTLE"
config/description="لعبة أكشن عسكرية ثلاثية الأبعاد — حملة، مركبات، لعب جماعي محلي."
config/version="2.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.0196078, 0.027451, 0.0431373, 1)
boot_splash/show_image=false

[autoload]

SaveSystem="*res://scripts/save/save_system.gd"
Loc="*res://scripts/localization/locale.gd"
WeaponsDB="*res://scripts/core/weapons_db.gd"
VehiclesDB="*res://scripts/core/vehicles_db.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
GameSettings="*res://scripts/settings/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansArabic-Regular.ttf"

[internationalization]

rendering/root_node_layout_direction=2

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.0196078, 0.027451, 0.0431373, 1)
